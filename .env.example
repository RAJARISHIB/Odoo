# =========================================================================
# HRMS Portal - shared environment reference
# Copy the relevant blocks into backend/.env and realtime/.env
# =========================================================================

# ---- Mongo ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=hrms

# ---- JWT (MUST be identical in Django and the Express WSS server) ----
JWT_SECRET=change-me-in-production-super-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7

# ---- Internal service-to-service key (Django -> Express publish) ----
INTERNAL_API_KEY=change-me-internal-service-key

# ---- Django ----
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Public origin of the API. Uploaded files are stored relative and served as
# absolute URLs built from this, so the Angular app can load them.
API_PUBLIC_URL=http://localhost:8000

# Where the Angular app lives. Browsing to the API host redirects here, so
# "localhost:8000" lands on the sign-in page instead of a 404.
FRONTEND_URL=http://localhost:4200
FRONTEND_LOGIN_PATH=/auth/login

# ---- File store (company logos, avatars) ----
# A plain directory, so it can be a Docker volume in deployment.
MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=5242880

# ---- Realtime (Express WSS) ----
REALTIME_PORT=4000
REALTIME_HTTP_URL=http://localhost:4000
REALTIME_WS_URL=ws://localhost:4000/ws

# ---- SMTP Email Configuration ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HRMS Portal <noreply@hrms.com>
