# ---- Server ----
NODE_ENV=development
REALTIME_PORT=4000
REALTIME_WS_PATH=/ws
LOG_LEVEL=info

# ---- JWT (MUST match backend/.env) ----
JWT_SECRET=change-me-in-production-super-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=hrms-api

# ---- Internal service key (MUST match backend/.env) ----
INTERNAL_API_KEY=change-me-internal-service-key

# ---- Django callback ----
DJANGO_API_URL=http://localhost:8000
DJANGO_PRESENCE_PATH=/api/v1/internal/realtime/presence
PRESENCE_CALLBACK_ENABLED=true
DJANGO_TIMEOUT_MS=5000

# ---- CORS / sockets ----
CORS_ALLOWED_ORIGINS=http://localhost:4200
WS_HEARTBEAT_INTERVAL_MS=30000
WS_AUTH_GRACE_MS=5000
WS_MAX_CONNECTIONS_PER_USER=10
